

/* ───────── BODY ───────── */
body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    background:#07070f;
    overflow:hidden;
    font-family:'Poppins',sans-serif;
    color:#fff;
    position:relative;
}

/* Animated glowing orbs */
body::before{
    content:'';
    position:fixed;
    width:520px;
    height:520px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(124,58,237,0.45) 0%, transparent 70%);
    top:-140px;
    right:-120px;
    filter:blur(85px);
    animation:floatOrb 8s ease-in-out infinite alternate;
}

body::after{
    content:'';
    position:fixed;
    width:450px;
    height:450px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(236,72,153,0.35) 0%, transparent 70%);
    bottom:-120px;
    left:-90px;
    filter:blur(85px);
    animation:floatOrb 8s ease-in-out infinite alternate-reverse;
}

@keyframes floatOrb{
    from{
        transform:translate(0,0) scale(1);
    }
    to{
        transform:translate(35px,25px) scale(1.12);
    }
}

/* ───────── FORM CARD ───────── */
form{
    position:relative;
    z-index:1;
    width:400px;
    max-width:92vw;
    padding:50px 42px 42px;
    border-radius:28px;

    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.08);

    backdrop-filter:blur(28px);
    -webkit-backdrop-filter:blur(28px);

    box-shadow:
        0 0 0 1px rgba(255,255,255,0.03) inset,
        0 0 80px rgba(124,58,237,0.22),
        0 28px 70px rgba(0,0,0,0.45);

    display:flex;
    flex-direction:column;

    animation:cardIn .7s cubic-bezier(0.34,1.56,0.64,1) both;
}

@keyframes cardIn{
    from{
        opacity:0;
        transform:translateY(45px) scale(.92);
    }
    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }
}

/* Top gradient line */
form::before{
    content:'';
    position:absolute;
    top:0;
    left:14%;
    right:14%;
    height:3px;
    border-radius:0 0 10px 10px;

    background:linear-gradient(
        90deg,
        #7c3aed,
        #ec4899,
        #f97316
    );

    box-shadow:0 0 18px rgba(236,72,153,0.6);
}

/* Inner glow */
form::after{
    content:'';
    position:absolute;
    inset:0;
    border-radius:28px;

    background:radial-gradient(
        ellipse 70% 50% at 50% 0%,
        rgba(124,58,237,0.08) 0%,
        transparent 70%
    );

    pointer-events:none;
}

/* ───────── HEADING ───────── */
h2{
    position:relative;
    z-index:1;

    margin-bottom:28px;

    font-size:30px;
    font-weight:800;
    letter-spacing:-0.5px;
    text-align:center;

    background:linear-gradient(
        135deg,
        #a78bfa 0%,
        #ec4899 60%,
        #f97316 100%
    );

    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    background-clip:text;
}

/* ───────── PASSWORD INPUT ───────── */
input[type="password"]{
    width:100%;
    padding:15px 20px;
    margin-bottom:24px;

    border-radius:15px;
    border:1px solid rgba(255,255,255,0.1);

    background:rgba(255,255,255,0.06);
    color:#f8fafc;

    outline:none;

    font-size:14px;
    font-family:'Poppins',sans-serif;
    letter-spacing:.12em;

    transition:
        .3s border-color,
        .3s background,
        .3s box-shadow,
        .2s transform;
}

input[type="password"]::placeholder{
    color:rgba(255,255,255,0.28);
    letter-spacing:normal;
}

input[type="password"]:hover{
    border-color:rgba(167,139,250,0.4);
    background:rgba(255,255,255,0.08);
}

input[type="password"]:focus{
    border-color:#7c3aed;
    background:rgba(124,58,237,0.1);

    box-shadow:
        0 0 0 3px rgba(124,58,237,0.22),
        0 4px 16px rgba(124,58,237,0.2);

    transform:translateY(-1px);
}

/* ───────── BUTTON ───────── */
input[type="submit"]{
    position:relative;
    overflow:hidden;

    width:100%;
    padding:15px;

    border:none;
    border-radius:50px;

    background:linear-gradient(
        135deg,
        #7c3aed 0%,
        #a855f7 50%,
        #ec4899 100%
    );

    color:#fff;

    font-size:15px;
    font-weight:700;
    letter-spacing:.5px;
    font-family:'Poppins',sans-serif;

    cursor:pointer;

    box-shadow:
        0 6px 28px rgba(124,58,237,0.5),
        0 2px 8px rgba(0,0,0,0.3);

    transition:
        transform .22s,
        box-shadow .22s;
}

/* Shimmer effect */
input[type="submit"]::after{
    content:'';
    position:absolute;

    top:0;
    left:-100%;

    width:60%;
    height:100%;

    background:linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,0.18),
        transparent
    );

    transform:skewX(-20deg);
    transition:left .55s ease;
}

input[type="submit"]:hover{
    transform:translateY(-4px);

    box-shadow:
        0 12px 36px rgba(236,72,153,0.55);
}

input[type="submit"]:hover::after{
    left:160%;
}

input[type="submit"]:active{
    transform:translateY(-1px);
}

/* ───────── MOBILE ───────── */
@media(max-width:480px){

    form{
        padding:42px 24px 34px;
    }

    h2{
        font-size:24px;
    }

}